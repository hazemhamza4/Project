<?xml version="1.0"?>
<robot name="puzzle_piece">
  <link name="piece_link">
    <!-- الإطار الخارجي (أبيض) -->
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.05 0.05 0.01"/>
      </geometry>
      <material name="white">
        <color rgba="1.0 1.0 1.0 1.0"/>
      </material>
    </visual>

    <!-- القلب الداخلي (أحمر) فوقه مباشرة -->
    <visual>
      <origin xyz="0 0 0.001" rpy="0 0 0"/>
      <geometry>
        <box size="0.035 0.035 0.012"/>
      </geometry>
      <material name="red">
        <color rgba="0.9 0.1 0.1 1.0"/>
      </material>
    </visual>

    <collision>
      <geometry>
        <box size="0.05 0.05 0.01"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="0.05"/>
      <inertia ixx="0.0001" ixy="0" ixz="0" iyy="0.0001" iyz="0" izz="0.0001"/>
    </inertial>
  </link>

  <!-- تعريف الخامة لغازيبو لضمان ظهور الألوان -->
  <gazebo reference="piece_link">
    <material>Gazebo/Red</material>
  </gazebo>
</robot>
