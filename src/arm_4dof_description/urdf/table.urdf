<?xml version="1.0"?>
<robot name="puzzle_table">
  <link name="puzzle_board">
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.05"/>
      </geometry>
      <material name="wood">
        <color rgba="0.6 0.4 0.2 1.0"/>
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0"/>
      <geometry>
        <box size="0.3 0.3 0.05"/>
      </geometry>
    </collision>
    <inertial>
      <mass value="10.0"/>
      <inertia ixx="0.1" ixy="0" ixz="0" iyy="0.1" iyz="0" izz="0.1"/>
    </inertial>
  </link>

  <gazebo reference="puzzle_board">
    <static>true</static>
    <mu1>100.0</mu1>
    <mu2>100.0</mu2>
  </gazebo>
</robot>
