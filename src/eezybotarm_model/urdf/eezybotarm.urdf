<?xml version="1.0"?>
<robot name="eezybotarm">
  <material name="blue">
    <color rgba="0 0 0.8 1"/>
  </material>
  <material name="black">
    <color rgba="0.1 0.1 0.1 1"/>
  </material>

  <link name="base_link">
    <visual>
      <geometry>
        <cylinder length="0.05" radius="0.04"/>
      </geometry>
      <material name="black"/>
    </visual>
  </link>

  <link name="link_1">
    <visual>
      <geometry>
        <box size="0.03 0.03 0.1"/>
      </geometry>
      <material name="blue"/>
      <origin xyz="0 0 0.05"/>
    </visual>
  </link>

  <joint name="joint_1" type="revolute">
    <parent link="base_link"/>
    <child link="link_1"/>
    <origin xyz="0 0 0.025"/>
    <axis xyz="0 0 1"/>
    <limit lower="-1.57" upper="1.57" effort="10" velocity="1"/>
  </joint>
</robot>
